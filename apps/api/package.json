{
  "name": "@mma/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "wrangler d1 execute DB --local --file=../../database/seed/0001_reference.sql && wrangler d1 execute DB --local --file=../../database/seed/0002_admin.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mma/db": "workspace:*",
    "@mma/realtime": "workspace:*",
    "@mma/shared": "workspace:*",
    "@mma/validation": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2",
    "@types/node": "^24.0.0"
  }
}
