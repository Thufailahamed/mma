# Local development.
#
# wrangler dev serves plain HTTP here. Browsers treat http://localhost as a
# secure context and accept the Secure session cookie on it, so the cookie
# model is identical to production. Running the API over wrangler's
# self-signed HTTPS would break the Next rewrite proxy, because Node's fetch
# rejects an untrusted certificate.
API_ORIGIN=http://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000
